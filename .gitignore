# Local credentials and machine-specific configuration.
.env*
!.env.example
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.keystore

# Generated or locally obtained material. Tracked benchmark data under module
# source trees is intentional and is therefore not covered by blanket data-file
# exclusions.
downloads/
local-data/
private-data/
artifacts/
outputs/
results/
runs/
checkpoints/
models/
scratch/
tmp/
temp/
*-results/

# Formats that commonly retain EXIF metadata, document authors, notebook
# outputs, embedded paths, or large generated model artifacts. Required files
# in these formats must be force-added only after inspection.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.bmp
*.tif
*.tiff
*.svg
*.ico
*.pdf
*.doc
*.docx
*.ppt
